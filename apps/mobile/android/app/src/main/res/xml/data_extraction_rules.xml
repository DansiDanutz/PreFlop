<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is copied by cloud backup or device-to-device transfer (Android 12+). The WebView's storage
  holds the player's session token, and a copy restored on another device must not stay signed in.
  android:allowBackup="false" covers older Android versions.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
