{
  "name": "@preflop/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PreFlop native apps (iOS and Android): a Capacitor shell around the player web app (apps/web)",
  "scripts": {
    "web": "pnpm --filter @preflop/web build -- --mode native",
    "sync": "pnpm run web && cap sync",
    "android": "cap open android",
    "ios": "cap open ios",
    "assets": "capacitor-assets generate --ios --android --iconBackgroundColor '#0e1311' --iconBackgroundColorDark '#0e1311' --splashBackgroundColor '#0e1311' --splashBackgroundColorDark '#0e1311'"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.2",
    "typescript": "^5.7.0"
  }
}
