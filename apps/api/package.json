{
  "name": "@preflop/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=preflop-source src/main.ts",
    "start": "node dist/main.js",
    "worker": "tsx --conditions=preflop-source src/workerMain.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "tsx --conditions=preflop-source src/sim/cli.ts",
    "demo": "tsx --conditions=preflop-source src/demo.ts",
    "soak": "tsx --conditions=preflop-source src/sim/soak.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/websocket": "^11.0.0",
    "@preflop/db": "workspace:*",
    "@preflop/odds-engine": "workspace:*",
    "fastify": "^5.2.0",
    "nodemailer": "^10.0.13",
    "pg": "^8.13.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@preflop/client": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.6",
    "vitest": "^3.0.0",
    "ws": "^8.18.0"
  }
}
