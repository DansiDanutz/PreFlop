# docker compose reads this file as .env (cp .env.example .env). Never commit the .env itself.
#
# Database password shared by the postgres, api and sim services. The API image runs with
# NODE_ENV=production and refuses demo values (preflop, postgres, …) and passwords under 16
# characters. Generate one:
#   openssl rand -hex 24
# A hex password needs no escaping inside the DATABASE_URL that compose builds from it.
POSTGRES_PASSWORD=
